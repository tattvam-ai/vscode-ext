{
	"name": "verification-workbench",
	"displayName": "Verification Workbench",
	"description": "Simple Chip Assistant for verification assistance",
	"version": "0.0.1",
	"engines": {
		"vscode": "^1.105.0"
	},
	"categories": [
		"Other"
	],
  "activationEvents": [],
	"main": "./out/extension.js",
	"browser": "./out/extension.js",
	"extensionDependencies": [
		"mshr-h.veriloghdl"
	],
	"contributes": {
		"commands": [
			{
				"command": "aiTerminal.show",
				"title": "Show Chip Assistant",
				"icon": "$(terminal)"
			},
			{ "command": "chipAssistant.explainSelection", "title": "Explain Selection" },
			{ "command": "chipAssistant.findBugsSelection", "title": "Find Bugs in Selection" },
			{ "command": "chipAssistant.assertionsSelection", "title": "Generate SystemVerilog Assertions" },
			{ "command": "chipAssistant.optimizeSelection", "title": "Optimize Selection" },
			{ "command": "chipAssistant.cocotbTestSelection", "title": "Generate TB" },
			{
				"command": "chipAssistant.setApiKey",
				"title": "Chip Assistant: Set OpenAI API Key"
			},
			{
				"command": "chipAssistant.clearApiKey",
				"title": "Chip Assistant: Clear OpenAI API Key"
			},
			{
				"command": "chipAssistant.toggleAdvancedModel",
				"title": "Chip Assistant: Toggle Advanced Model"
			},
			{
				"command": "chipAssistant.useAdvancedModel",
				"title": "Chip Assistant: Use Advanced Model (Large Context)"
			},
			{
				"command": "chipAssistant.useStandardModel",
				"title": "Chip Assistant: Use Standard Model"
			},
			{ "command": "openroad.setFlowHome", "title": "OpenROAD: Set FLOW_HOME" },
			{ "command": "openroad.configureFlow", "title": "OpenROAD: Configure Flow" },
			{ "command": "openroad.runFlow", "title": "OpenROAD: Run Flow" },
			{ "command": "openroad.stopFlow", "title": "OpenROAD: Stop Flow" },
			{ "command": "openroad.cleanAll", "title": "OpenROAD: Clean All" },
			{ "command": "openroad.actions", "title": "OpenROAD: Actions" },
			{ "command": "openroad.guiFinal", "title": "OpenROAD: Show GUI (gui_final)" },
			{ "command": "cocotb.runTests", "title": "Cocotb: Run Tests" },
			{ "command": "cocotb.stopTests", "title": "Cocotb: Stop Tests" },
			{ "command": "cocotb.cleanTests", "title": "Cocotb: Clean Tests" },
			{ "command": "cocotb.generateMakefile", "title": "Cocotb: Generate Makefile" },
			{ "command": "cocotb.checkPrerequisites", "title": "Cocotb: Check Prerequisites" },
			{ "command": "cocotb.installCocotb", "title": "Cocotb: Install Cocotb" },
			{ "command": "cocotb.installSimulator", "title": "Cocotb: Install Simulator" },
			{ "command": "cocotb.debugSimulatorDetection", "title": "Cocotb: Debug Simulator Detection" },
			{ "command": "cocotb.generateTestbench", "title": "Cocotb: Generate Testbench" },
			{ "command": "verilator.checkPrerequisites", "title": "Verilator: Check Prerequisites" },
			{ "command": "verilator.compile", "title": "Verilator: Compile" },
			{ "command": "verilator.runSimulation", "title": "Verilator: Run Simulation" },
			{ "command": "verilator.stopSimulation", "title": "Verilator: Stop Simulation" },
			{ "command": "verilator.clean", "title": "Verilator: Clean" },
			{ "command": "verilator.setTestDirectory", "title": "Verilator: Set Test Directory" },
			{ "command": "chipAssistant.analyzeReports", "title": "Chip Assistant: Analyze Design Reports" }
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "aiTerminalContainer",
					"title": "Chip Assistant",
					"icon": "$(robot)"
				},
				{
					"id": "cocotbContainer",
					"title": "Cocotb",
					"icon": "$(beaker)"
				},
				{
					"id": "verilatorContainer",
					"title": "Verilator",
					"icon": "$(gear)"
				},
				{
					"id": "openroadContainer",
					"title": "OpenROAD",
					"icon": "$(tools)"
				}
			]
		},
		"views": {
			"aiTerminalContainer": [
				{
					"id": "aiTerminalView",
					"name": "Chip Assistant",
					"type": "webview",
					"when": "true"
				}
			],
			"openroadContainer": [
				{
					"id": "openroadSidebar",
					"name": "OpenROAD",
					"type": "webview",
					"when": "true"
				}
			],
			"cocotbContainer": [
				{
					"id": "cocotbSidebar",
					"name": "Cocotb Tests",
					"type": "webview",
					"when": "true"
				}
			],
			"verilatorContainer": [
				{
					"id": "verilatorSidebar",
					"name": "Verilator",
					"type": "webview",
					"when": "true"
				}
			]
		},
		"configuration": {
			"title": "Chip Assistant",
			"properties": {
				"chipAssistant.openai.model": {
					"type": "string",
					"default": "o3-mini",
					"description": "OpenAI model name (e.g., o3-mini, gpt-4o-mini, gpt-5-mini, gpt-4o, o1-preview, o1-mini)",
					"enum": [
						"o3-mini",
						"gpt-4o-mini",
						"gpt-5-mini",
						"gpt-4o",
						"o1-preview",
						"o1-mini",
						"gpt-4-turbo",
						"gpt-4"
					]
				},
				"chipAssistant.openai.useAdvancedModel": {
					"type": "boolean",
					"default": false,
					"description": "Temporarily use advanced model with larger context window (o1-preview or gpt-4o)"
				},
				"chipAssistant.openai.advancedModel": {
					"type": "string",
					"default": "gpt-4o",
					"description": "Advanced model to use when useAdvancedModel is enabled",
					"enum": [
						"gpt-4o",
						"gpt-4-turbo",
						"gpt-4",
						"gpt-5-mini",
						"o1-preview",
						"o1-mini"
					]
				},
				"chipAssistant.openai.baseUrl": {
					"type": "string",
					"default": "https://api.openai.com/v1",
					"description": "OpenAI API base URL"
				},
				"chipAssistant.request.timeoutMs": {
					"type": "number",
					"default": 180000,
					"description": "Request timeout in milliseconds (3 minutes default, 5 minutes for advanced models)"
				},
				"chipAssistant.showEffectivePrompt": {
					"type": "boolean",
					"default": true,
					"description": "Show the exact prompt sent to the model in the Chip Assistant view"
				},
				"openroad.flow.flowHome": {
					"type": "string",
					"default": "",
					"description": "Path to OpenROAD-flow-scripts root (FLOW_HOME)"
				},
				"openroad.flow.designConfig": {
					"type": "string",
					"default": "",
					"description": "Absolute path to DESIGN_CONFIG (config.mk)"
				},
				"openroad.flow.platform": {
					"type": "string",
					"default": "",
					"description": "Platform name (e.g., sky130hd, sky130hs, asap7)"
				},
				"openroad.flow.flowVariant": {
					"type": "string",
					"default": "base",
					"description": "Flow variant (e.g., base, hs, hd)"
				},
				"openroad.flow.designName": {
					"type": "string",
					"default": "",
					"description": "Design name (auto-deduced from config.mk path if empty)"
				},
				"openroad.flow.target": {
					"type": "string",
					"default": "",
					"description": "Optional make target (e.g., finish, floorplan). Leave empty to run default."
				},
				"openroad.flow.resultsRoot": {
					"type": "string",
					"default": "",
					"description": "Optional results root (overrides autodetect under FLOW_HOME/runs)"
				},
				"openroad.flow.envPreset": {
					"type": "string",
					"default": "none",
					"enum": ["none", "docker", "conda"],
					"description": "Optional environment preset for running the flow"
				},
				"cocotb.simulator.type": {
					"type": "string",
					"default": "iverilog",
					"enum": ["iverilog", "verilator", "ghdl", "questa", "xcelium"],
					"description": "HDL simulator to use with cocotb"
				},
				"cocotb.simulator.path": {
					"type": "string",
					"default": "",
					"description": "Path to simulator executable (auto-detected if empty)"
				},
				"cocotb.python.path": {
					"type": "string",
					"default": "",
					"description": "Path to Python executable for cocotb (auto-detected if empty). Use this if you have cocotb in a virtual environment."
				},
				"cocotb.testDirectory": {
					"type": "string",
					"default": "",
					"description": "Directory containing cocotb tests (auto-detected if empty)"
				},
				"cocotb.autoSetup": {
					"type": "boolean",
					"default": true,
					"description": "Automatically setup cocotb environment if not found"
				},
                "cocotb.autoOpenWaveform": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically open the latest GTKWave waveform after cocotb tests finish"
                },
				"verilator.testDirectory": {
					"type": "string",
					"default": "",
					"description": "Primary test directory where Verilator files are located (auto-detected if empty)"
				},
				"verilator.verilatorPath": {
					"type": "string",
					"default": "",
					"description": "Path to Verilator executable (auto-detected if empty)"
				},
				"verilator.cppCompiler": {
					"type": "string",
					"default": "g++",
					"description": "C++ compiler to use with Verilator (g++, clang++, etc.)"
				},
				"verilator.autoSetup": {
					"type": "boolean",
					"default": true,
					"description": "Automatically setup Verilator environment if not found"
				},
				"verilator.enableWall": {
					"type": "boolean",
					"default": true,
					"description": "Pass -Wall to Verilator for extra warnings"
				},
				"verilator.jobs": {
					"type": "number",
					"default": 0,
					"description": "Parallel build jobs for Verilator --build (-1 disables, 0 uses all cores, >0 sets exact jobs)"
				}
				,
				"verilator.systemcInclude": {
					"type": "string",
					"default": "",
					"description": "Override: path to SystemC include directory containing systemc.h"
				},
				"verilator.systemcLibdir": {
					"type": "string",
					"default": "",
					"description": "Override: path to directory containing libsystemc.a or libsystemc.so"
				}
			}
		},
		"menus": {
			"commandPalette": [
				{ "command": "aiTerminal.show" },
        { "command": "chipAssistant.analyzeReports" },
				{ "command": "openroad.setFlowHome" },
				{ "command": "openroad.configureFlow" },
				{ "command": "openroad.runFlow" },
				{ "command": "openroad.stopFlow" },
				{ "command": "openroad.cleanAll" },
				{ "command": "openroad.actions" },
				{ "command": "openroad.guiFinal" },
				{ "command": "cocotb.runTests" },
				{ "command": "cocotb.stopTests" },
				{ "command": "cocotb.cleanTests" },
				{ "command": "cocotb.generateMakefile" },
				{ "command": "cocotb.checkPrerequisites" },
				{ "command": "cocotb.installCocotb" },
				{ "command": "cocotb.installSimulator" },
				{ "command": "cocotb.debugSimulatorDetection" },
				{ "command": "cocotb.generateTestbench" },
				{ "command": "verilator.checkPrerequisites" },
				{ "command": "verilator.compile" },
				{ "command": "verilator.runSimulation" },
				{ "command": "verilator.stopSimulation" },
				{ "command": "verilator.clean" },
				{ "command": "verilator.setTestDirectory" }
			],
			"editor/context": [
				{ "command": "chipAssistant.explainSelection", "when": "editorHasSelection", "group": "chipAssistant@100" },
				{ "command": "chipAssistant.findBugsSelection", "when": "editorHasSelection", "group": "chipAssistant@101" },
				{ "command": "chipAssistant.assertionsSelection", "when": "editorHasSelection", "group": "chipAssistant@102" },
				{ "command": "chipAssistant.optimizeSelection", "when": "editorHasSelection", "group": "chipAssistant@103" },
				{ "command": "chipAssistant.cocotbTestSelection", "when": "editorHasSelection", "group": "chipAssistant@104" }
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/vscode": "^1.74.0",
		"@types/node": "16.x",
		"typescript": "^4.9.4"
	},
	"dependencies": {
		"undici": "^6.19.8"
	}
}
